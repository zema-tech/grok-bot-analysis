product_publishes_to_apt_suite() {
  [ "Grok Bot" = "Grok Bot" ]
}

if product_publishes_to_apt_suite; then
  if ! register_error="$(register_grok_bot_apt_source 2>&1 >/dev/null)"; then
    rm -f "$GROK_BOT_KEYRING.tmp" "$GROK_BOT_SOURCES.tmp"
    echo "warning: grok-bot apt source not registered ($register_error)" >&2
  fi
fi
