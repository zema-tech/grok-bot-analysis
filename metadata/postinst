#!/bin/bash

if type update-alternatives >/dev/null 2>&1; then
    if [ -L '/usr/bin/grok-bot' -a -e '/usr/bin/grok-bot' -a "`readlink '/usr/bin/grok-bot'`" != '/etc/alternatives/grok-bot' ]; then
        rm -f '/usr/bin/grok-bot'
    fi
    update-alternatives --install '/usr/bin/grok-bot' 'grok-bot' '/opt/Grok Bot/grok-bot' 100 || ln -sf '/opt/Grok Bot/grok-bot' '/usr/bin/grok-bot'
else
    ln -sf '/opt/Grok Bot/grok-bot' '/usr/bin/grok-bot'
fi

if ! { [[ -L /proc/self/ns/user ]] && unshare --user true; }; then
    chmod 4755 '/opt/Grok Bot/chrome-sandbox' || true
else
    chmod 0755 '/opt/Grok Bot/chrome-sandbox' || true
fi

if hash update-mime-database 2>/dev/null; then
    update-mime-database /usr/share/mime || true
fi

if hash update-desktop-database 2>/dev/null; then
    update-desktop-database /usr/share/applications || true
fi

# apparmor_parser --skip-kernel-load performs every action except loading the profile into the kernel and --debug given once only checks its syntax, so this probe tells whether the installed parser accepts the bundled profile before cp -f installs it: https://manpages.debian.org/trixie/apparmor/apparmor_parser.8.en.html
if apparmor_status --enabled > /dev/null 2>&1; then
  APPARMOR_PROFILE_SOURCE='/opt/Grok Bot/resources/apparmor-profile'
  APPARMOR_PROFILE_TARGET='/etc/apparmor.d/grok-bot'
  if apparmor_parser --skip-kernel-load --debug "$APPARMOR_PROFILE_SOURCE" > /dev/null 2>&1; then
    cp -f "$APPARMOR_PROFILE_SOURCE" "$APPARMOR_PROFILE_TARGET"

    if ! { [ -x '/usr/bin/ischroot' ] && /usr/bin/ischroot; } && hash apparmor_parser 2>/dev/null; then
      # apparmor_parser(8) advises pairing --write-cache with --skip-read-cache when the parser runs with --replace and abstractions have changed, because a cache newer than the profile is otherwise loaded instead of the file: https://manpages.debian.org/trixie/apparmor/apparmor_parser.8.en.html
      apparmor_parser --replace --write-cache --skip-read-cache "$APPARMOR_PROFILE_TARGET"
    fi
  else
    echo "Skipping the installation of the AppArmor profile as this version of AppArmor does not seem to support the bundled profile"
  fi

  # Electron fails to start where kernel.apparmor_restrict_unprivileged_userns=1, the Ubuntu 24.04 default (https://github.com/electron/electron/issues/41066), and its SUID chrome-sandbox fallback fails to execvp from an install path containing a space (https://github.com/electron/electron/issues/44414), so the check below warns when the AppArmor profile above is not loaded.
  if [ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null)" = 1 ] &&
    ! { [ -x '/usr/bin/ischroot' ] && /usr/bin/ischroot; } &&
    ! grep -q '^grok-bot ' /sys/kernel/security/apparmor/profiles 2>/dev/null; then
    if [ -f "$APPARMOR_PROFILE_TARGET" ]; then
      echo "warning: the AppArmor profile grok-bot is not loaded and this kernel restricts unprivileged user namespaces; Grok Bot exits at launch until the profile is loaded (sudo apparmor_parser -r '$APPARMOR_PROFILE_TARGET')" >&2
    else
      echo "warning: this version of apparmor_parser rejected the bundled AppArmor profile and this kernel restricts unprivileged user namespaces; Grok Bot cannot start its sandbox on this kernel until the apparmor package is updated and Grok Bot is reinstalled" >&2
    fi
  fi
fi

dearmor_without_gpg() {
  grep -vE '^(-----|=|$)' | base64 -d
}

# Sand gets its own suite rather than a component under stable because apt applies Signed-By to every source with the same URI and Suite and errors out when two entries disagree, even if the keyrings hold the same key: https://manpages.debian.org/trixie/apt/sources.list.5.en.html
APT_SOURCE_PARTS=/etc/apt/sources.list.d/
eval "$(apt-config shell APT_SOURCE_PARTS Dir::Etc::sourceparts/d 2>/dev/null)"
GROK_BOT_SOURCES="$APT_SOURCE_PARTS"grok-bot.sources
GROK_BOT_KEYRING=/usr/share/keyrings/grok-bot.gpg

preserved_enabled_field() {
  if grep -qiE '^Enabled:[[:space:]]*no[[:space:]]*$' "$GROK_BOT_SOURCES" 2>/dev/null; then
    echo "Enabled: no"
  fi
}

